  "fixed_sql": [
    {
      "name": "questions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"questions\" (\"id\" TEXT NOT NULL, \"tema\" INTEGER NOT NULL, \"section\" TEXT NULL, \"stem\" TEXT NOT NULL, \"options\" TEXT NOT NULL, \"answer\" INTEGER NOT NULL, \"explanation\" TEXT NULL, \"article\" TEXT NULL, \"flags\" TEXT NOT NULL, \"edition\" TEXT NOT NULL, \"reviewed\" INTEGER NOT NULL CHECK (\"reviewed\" IN (0, 1)), \"retired\" INTEGER NOT NULL DEFAULT 0 CHECK (\"retired\" IN (0, 1)), \"notice\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attempts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"question_id\" TEXT NOT NULL, \"mode\" TEXT NOT NULL, \"selected\" INTEGER NULL, \"correct\" INTEGER NOT NULL CHECK (\"correct\" IN (0, 1)), \"answered_at\" TEXT NOT NULL, \"mock_id\" INTEGER NULL, \"elapsed_ms\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "srs_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"srs_state\" (\"question_id\" TEXT NOT NULL, \"box\" INTEGER NOT NULL, \"due_at\" TEXT NOT NULL, \"reps\" INTEGER NOT NULL, \"lapses\" INTEGER NOT NULL, \"last_answered_at\" TEXT NULL, PRIMARY KEY (\"question_id\"));"
        }
      ]
    },
    {
      "name": "mocks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mocks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT NULL, \"question_ids\" TEXT NOT NULL, \"answers\" TEXT NOT NULL, \"correct_count\" INTEGER NULL, \"passed\" INTEGER NULL CHECK (\"passed\" IN (0, 1)), \"timed\" INTEGER NOT NULL CHECK (\"timed\" IN (0, 1)), \"pass_mark\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "questions_tema",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX questions_tema ON questions (tema)"
        }
      ]
    },
    {
      "name": "attempts_question_answered",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX attempts_question_answered ON attempts (question_id, answered_at)"
        }
      ]
    },
    {
      "name": "attempts_mock",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX attempts_mock ON attempts (mock_id)"
