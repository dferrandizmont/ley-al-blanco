{% extends 'base/layout.html.j2' %}
{% from 'icons.html.j2' import icon %}
{% block content %}
<div class="wrap">
<div class="doc nf">
<p class="no tab">404</p>
<h1 class="ph">{{ t.not_found }}</h1>
<p class="lead">{{ t.not_found_text }}</p>
<ul class="home-links">
{% for code in site.languages %}<li><a class="btn line" href="{{ route(code) }}" lang="{{ code }}" hreflang="{{ code }}"><span class="bt">{{ t.home }}{% if site.languages | length > 1 %} · {{ t.languages[code] }}{% endif %}</span>{{ icon('arrow_forward') }}</a></li>
{% endfor %}</ul>
</div>
</div>
{% endblock %}
