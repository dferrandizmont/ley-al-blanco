{% extends 'base/layout.html.j2' %}
{% from 'base/screenshots.html.j2' import picture %}
{% from 'icons.html.j2' import icon %}
{% macro sec_head(number, title) -%}
<div class="sh"><span class="no tab">{{ '%02d' | format(number) }}</span><h2>{{ title }}</h2></div>
{%- endmacro %}
{% block content %}
{% set privacy_icons = ['smartphone', 'block', 'link'] %}
<section id="about" class="wrap">
<div class="hero">
<div class="hm">
<h1>{{ c.name }}</h1>
<p class="intro">{{ c.intro }}</p>
<ul class="facts">
{% for fact in c.key_facts.split(' · ') %}<li>{{ icon('check', 's') }}{{ fact }}{% if not loop.last %}<span class="vh" aria-hidden="true"> · </span>{% endif %}</li>
{% endfor %}</ul>
<p class="notice">{{ icon('info', 's') }}<span>{{ c.disclaimer }}</span></p>
</div>
<div class="spec">
<h2 class="lab" id="spec-label">{{ c.specs_label }}</h2>
<table aria-labelledby="spec-label">
<tbody>
{% for row in c.specs %}<tr><th scope="row">{{ row.label }}</th><td>{% set value = row.get("value", "") %}{% set unit = row.get("unit", "") %}{% if value %}<b class="tab">{{ value }}</b>{% endif %}{% if value and unit %} {% endif %}{{ unit }}</td></tr>
{% endfor %}</tbody>
</table>
</div>
</div>
</section>

<section id="download" class="wrap">
<div class="sec">
{{ sec_head(1, t.download) }}
<div class="dl">
<div class="plat">
<h3>{{ t.android }}</h3>
<div class="stack">
{% for kind in ['apk', 'play', 'fdroid'] %}{% for item in site.downloads if item.kind == kind %}
{% if item.state == 'soon' %}<span class="btn off" aria-disabled="true"><span class="bt">{{ t[item.kind] }} <span class="dot">·</span> {{ t[item.state] }}</span></span>
{% elif item.kind == 'apk' %}<a class="btn pri" href="{{ item.url }}">{{ icon('download') }}<span class="bt">{{ t[item.kind] }}</span><span class="st">{{ t[item.state] }}</span></a>
{% else %}{% if item.kind == 'play' %}<p class="hint">{{ c.testers_hint }}</p>
<a class="lnk" href="{{ c.testers_group_url }}">{{ icon('group', 's') }}{{ c.testers_group }}</a>
{% endif %}<a class="btn line" href="{{ item.url }}"><span class="bt">{{ t[item.kind] }} <span class="dot">·</span> {{ t[item.state] }}</span></a>
{% endif %}
{% endfor %}{% endfor %}
</div>
</div>
<div class="plat">
<h3>{{ t.ios }}</h3>
<div class="stack">
{% for kind in ['testflight', 'app_store'] %}{% for item in site.downloads if item.kind == kind %}
{% if item.state == 'soon' %}<span class="btn off" aria-disabled="true"><span class="bt">{{ t[item.kind] }} <span class="dot">·</span> {{ t[item.state] }}</span></span>
{% else %}<a class="btn line" href="{{ item.url }}"><span class="bt">{{ t[item.kind] }} <span class="dot">·</span> {{ t[item.state] }}</span></a>
{% endif %}
{% endfor %}{% endfor %}
</div>
</div>
</div>
</div>
</section>

<section id="screenshots" class="wrap">
<div class="sec">
{{ sec_head(2, t.screenshots) }}
<div class="strip" tabindex="0" role="region" aria-label="{{ c.shots_label }}">
<ol>
{% for shot in shots %}<li><figure>{{ picture(shot, loop.first, '(min-width: 761px) 200px, 56vw') }}<figcaption><b class="tab">{{ '%02d' | format(loop.index) }}</b><span>{{ shot.alt }}</span></figcaption></figure></li>
{% endfor %}</ol>
</div>
</div>
</section>

<section id="features" class="wrap">
<div class="sec">
{{ sec_head(3, t.features) }}
<ol class="feat">
{% for feature in c.features %}<li data-feature><span class="n tab">{{ '%02d' | format(loop.index) }}</span><p>{{ feature }}</p></li>
{% endfor %}</ol>
</div>
</section>

<section id="privacy" class="wrap">
<div class="sec">
{{ sec_head(4, t.privacy) }}
<div>
<ul class="tri">
{% for sentence in c.privacy_summary %}<li>{{ icon(privacy_icons[loop.index0 % (privacy_icons | length)]) }}<p>{{ sentence }}</p></li>
{% endfor %}</ul>
<a class="more" href="{{ route(lang, true) }}">{{ t.privacy_full }}{{ icon('arrow_forward', 's') }}</a>
</div>
</div>
</section>

<section id="support" class="wrap">
<div class="sec">
{{ sec_head(5, t.support) }}
<div class="sup">
<div>
<h3 class="over">{{ t.faq }}</h3>
<div class="faq">
{% for item in c.faq %}<details{% if loop.first %} open{% endif %}><summary>{{ item.question }}</summary><p>{{ item.answer }}</p></details>
{% endfor %}</div>
</div>
<div class="contact">
<h3 class="over">{{ c.mail_label }}</h3>
<a class="btn line" href="mailto:{{ contact_email }}">{{ icon('mail') }}<span class="bt">{{ t.contact }}</span></a>
<span class="mail">{{ contact_email }}</span>
</div>
</div>
</div>
</section>
{% endblock %}
